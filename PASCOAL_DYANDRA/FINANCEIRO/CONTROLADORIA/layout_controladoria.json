          "f": "=IF($A2=\"\",\"\",SUMIFS(RECEBIMENTOS!$E$2:$E$5000,RECEBIMENTOS!$B$2:$B$5000,$A2,RECEBIMENTOS!$D$2:$D$5000,\"Êxito contratual\")+SUMIFS(RECEBIMENTOS!$E$2:$E$5000,RECEBIMENTOS!$B$2:$B$5000,$A2,RECEBIMENTOS!$D$2:$D$5000,\"Sucumbência\"))" },
        { "h": "A RECEBER DE ÊXITO",          "w": 20, "fmt": "moeda", "calc": true, "destaque": true, "alerta": true,
          "f": "=IF($A2=\"\",\"\",$H2+$I2-$J2)" },
        { "h": "Observações",                 "w": 45, "fmt": "geral" }
