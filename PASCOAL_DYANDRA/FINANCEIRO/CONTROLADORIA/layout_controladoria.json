  "abas": [
    {
      "nome": "PROCESSOS",
      "linhas": 1500,
      "congelar_linha": 1,
      "congelar_coluna": 2,
      "colunas": [
        { "h": "Nº Pasta",                  "w": 11, "fmt": "texto" },
        { "h": "Cliente",                   "w": 34, "fmt": "geral" },
        { "h": "CPF",                       "w": 16, "fmt": "texto" },
        { "h": "Nº do Processo (CNJ)",      "w": 26, "fmt": "texto" },
        { "h": "Área",                      "w": 15, "fmt": "geral" },
        { "h": "Parte Contrária / Reclamada","w": 30, "fmt": "geral" },
        { "h": "Responsável",               "w": 17, "fmt": "geral" },
        { "h": "Origem",                    "w": 14, "fmt": "geral" },
        { "h": "Indicante / Comissionado",  "w": 22, "fmt": "geral" },
        { "h": "Data do Contrato",          "w": 14, "fmt": "data" },
        { "h": "Status",                    "w": 24, "fmt": "geral" },
        { "h": "Tipo de Honorário",         "w": 22, "fmt": "geral" },
        { "h": "% Êxito Contratado",        "w": 14, "fmt": "pct" },
        { "h": "Honorário Fixo (R$)",       "w": 17, "fmt": "moeda" },
        { "h": "CTMP Mensal (R$)",          "w": 16, "fmt": "moeda" },
        { "h": "Nº de Parcelas",            "w": 12, "fmt": "int" },
        { "h": "Contratado Fixo Total",     "w": 19, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",N2+O2*P2)" },
        { "h": "Êxito Apurado",             "w": 16, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",SUMIF(EXITO!$A$2:$A$1500,$A2,EXITO!$H$2:$H$1500))" },
        { "h": "Sucumbência Apurada",       "w": 18, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",SUMIF(EXITO!$A$2:$A$1500,$A2,EXITO!$I$2:$I$1500))" },
        { "h": "Despesas Totais",           "w": 16, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",SUMIF(DESPESAS!$B$2:$B$5000,$A2,DESPESAS!$E$2:$E$5000))" },
        { "h": "Despesas a Reembolsar",     "w": 19, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",SUMIFS(DESPESAS!$E$2:$E$5000,DESPESAS!$B$2:$B$5000,$A2,DESPESAS!$F$2:$F$5000,\"SIM\",DESPESAS!$G$2:$G$5000,\"NÃO\"))" },
        { "h": "Despesas do Escritório",    "w": 19, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",SUMIFS(DESPESAS!$E$2:$E$5000,DESPESAS!$B$2:$B$5000,$A2,DESPESAS!$F$2:$F$5000,\"NÃO\"))" },
        { "h": "TOTAL A RECEBER",           "w": 18, "fmt": "moeda", "calc": true, "destaque": true,
          "f": "=IF($A2=\"\",\"\",Q2+R2+S2+U2)" },
        { "h": "RECEBIDO",                  "w": 16, "fmt": "moeda", "calc": true, "destaque": true,
          "f": "=IF($A2=\"\",\"\",SUMIF(RECEBIMENTOS!$B$2:$B$5000,$A2,RECEBIMENTOS!$E$2:$E$5000))" },
        { "h": "SALDO EM ABERTO",           "w": 18, "fmt": "moeda", "calc": true, "destaque": true, "alerta": true,
          "f": "=IF($A2=\"\",\"\",W2-X2)" },
        { "h": "Comissão a Pagar",          "w": 17, "fmt": "moeda", "calc": true,
          "f": "=IF($A2=\"\",\"\",SUMIFS(COMISSOES!$G$2:$G$2000,COMISSOES!$A$2:$A$2000,$A2,COMISSOES!$H$2:$H$2000,\"NÃO\"))" },
        { "h": "RESULTADO LÍQUIDO",         "w": 19, "fmt": "moeda", "calc": true, "destaque": true,
          "f": "=IF($A2=\"\",\"\",X2-V2-Z2)" },
        { "h": "Última Cobrança",           "w": 15, "fmt": "data" },
        { "h": "Observações",               "w": 45, "fmt": "geral" }
      ],
      "validacoes": [
        { "col": 5,  "lista": "LST_AREA" },
        { "col": 7,  "lista": "LST_RESP" },
        { "col": 8,  "lista": "LST_ORIGEM" },
        { "col": 11, "lista": "LST_STATUS" },
        { "col": 12, "lista": "LST_HONORARIO" }
