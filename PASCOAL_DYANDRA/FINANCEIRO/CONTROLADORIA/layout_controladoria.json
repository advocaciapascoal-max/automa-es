  "painel": {
    "titulo": "CONTROLADORIA FINANCEIRA DOS PROCESSOS",
    "subtitulo": "Pascoal & Dyandra Advocacia — CNPJ 55.540.563/0001-64 — Sorocaba/SP",
    "itens": [
      { "tipo": "secao", "texto": "CARTEIRA" },
      { "tipo": "kpi", "label": "Processos cadastrados",        "fmt": "int",
        "f": "=COUNTA(PROCESSOS!$A$2:$A$1500)" },
      { "tipo": "kpi", "label": "Processos ativos",             "fmt": "int",
        "f": "=COUNTIF(PROCESSOS!$K$2:$K$1500,\"Ativo - em andamento\")+COUNTIF(PROCESSOS!$K$2:$K$1500,\"Aguardando audiência\")+COUNTIF(PROCESSOS!$K$2:$K$1500,\"Em recurso\")+COUNTIF(PROCESSOS!$K$2:$K$1500,\"Em execução\")" },
      { "tipo": "kpi", "label": "Processos com saldo em aberto","fmt": "int",
        "f": "=COUNTIF(PROCESSOS!$Y$2:$Y$1500,\">0\")" },

      { "tipo": "secao", "texto": "A RECEBER" },
      { "tipo": "kpi", "label": "Contratado fixo total",        "fmt": "moeda",
        "f": "=SUM(PROCESSOS!$Q$2:$Q$1500)" },
      { "tipo": "kpi", "label": "Êxito apurado",                "fmt": "moeda",
        "f": "=SUM(PROCESSOS!$R$2:$R$1500)" },
      { "tipo": "kpi", "label": "Sucumbência apurada",          "fmt": "moeda",
        "f": "=SUM(PROCESSOS!$S$2:$S$1500)" },
      { "tipo": "kpi", "label": "Despesas a reembolsar",        "fmt": "moeda",
        "f": "=SUM(PROCESSOS!$U$2:$U$1500)" },
      { "tipo": "kpi", "label": "TOTAL A RECEBER",              "fmt": "moeda", "destaque": true,
        "f": "=SUM(PROCESSOS!$W$2:$W$1500)" },

      { "tipo": "secao", "texto": "REALIZADO" },
      { "tipo": "kpi", "label": "TOTAL RECEBIDO",               "fmt": "moeda", "destaque": true,
        "f": "=SUM(PROCESSOS!$X$2:$X$1500)" },
      { "tipo": "kpi", "label": "SALDO EM ABERTO (inadimplência)","fmt": "moeda", "destaque": true, "alerta": true,
        "f": "=SUM(PROCESSOS!$Y$2:$Y$1500)" },
      { "tipo": "kpi", "label": "% de inadimplência",           "fmt": "pct", "alerta": true,
        "f": "=IFERROR(SUM(PROCESSOS!$Y$2:$Y$1500)/SUM(PROCESSOS!$W$2:$W$1500),0)" },
      { "tipo": "kpi", "label": "Ticket médio recebido/processo","fmt": "moeda",
        "f": "=IFERROR(SUM(PROCESSOS!$X$2:$X$1500)/COUNTA(PROCESSOS!$A$2:$A$1500),0)" },

      { "tipo": "secao", "texto": "CUSTOS E RESULTADO" },
      { "tipo": "kpi", "label": "Despesas totais dos processos","fmt": "moeda",
        "f": "=SUM(PROCESSOS!$T$2:$T$1500)" },
      { "tipo": "kpi", "label": "Despesas por conta do escritório","fmt": "moeda",
        "f": "=SUM(PROCESSOS!$V$2:$V$1500)" },
      { "tipo": "kpi", "label": "Comissões a pagar",            "fmt": "moeda",
        "f": "=SUM(PROCESSOS!$Z$2:$Z$1500)" },
      { "tipo": "kpi", "label": "RESULTADO LÍQUIDO ACUMULADO",  "fmt": "moeda", "destaque": true,
        "f": "=SUM(PROCESSOS!$AA$2:$AA$1500)" },

      { "tipo": "grupo", "texto": "POR STATUS", "lista": "LST_STATUS", "criterio": "K",
        "cols": [
          { "h": "Qtde",           "fmt": "int",   "f": "=COUNTIF(PROCESSOS!$K$2:$K$1500,\"{V}\")" },
          { "h": "A Receber",      "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$K$2:$K$1500,\"{V}\",PROCESSOS!$W$2:$W$1500)" },
          { "h": "Recebido",       "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$K$2:$K$1500,\"{V}\",PROCESSOS!$X$2:$X$1500)" },
          { "h": "Saldo em Aberto","fmt": "moeda", "f": "=SUMIF(PROCESSOS!$K$2:$K$1500,\"{V}\",PROCESSOS!$Y$2:$Y$1500)" },
          { "h": "Resultado",      "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$K$2:$K$1500,\"{V}\",PROCESSOS!$AA$2:$AA$1500)" }
        ] },

      { "tipo": "grupo", "texto": "POR RESPONSÁVEL", "lista": "LST_RESP", "criterio": "G",
        "cols": [
          { "h": "Qtde",           "fmt": "int",   "f": "=COUNTIF(PROCESSOS!$G$2:$G$1500,\"{V}\")" },
          { "h": "A Receber",      "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$G$2:$G$1500,\"{V}\",PROCESSOS!$W$2:$W$1500)" },
          { "h": "Recebido",       "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$G$2:$G$1500,\"{V}\",PROCESSOS!$X$2:$X$1500)" },
          { "h": "Saldo em Aberto","fmt": "moeda", "f": "=SUMIF(PROCESSOS!$G$2:$G$1500,\"{V}\",PROCESSOS!$Y$2:$Y$1500)" },
          { "h": "Resultado",      "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$G$2:$G$1500,\"{V}\",PROCESSOS!$AA$2:$AA$1500)" }
        ] },

      { "tipo": "grupo", "texto": "POR ORIGEM DO CLIENTE", "lista": "LST_ORIGEM", "criterio": "H",
        "cols": [
          { "h": "Qtde",           "fmt": "int",   "f": "=COUNTIF(PROCESSOS!$H$2:$H$1500,\"{V}\")" },
          { "h": "A Receber",      "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$H$2:$H$1500,\"{V}\",PROCESSOS!$W$2:$W$1500)" },
          { "h": "Recebido",       "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$H$2:$H$1500,\"{V}\",PROCESSOS!$X$2:$X$1500)" },
          { "h": "Saldo em Aberto","fmt": "moeda", "f": "=SUMIF(PROCESSOS!$H$2:$H$1500,\"{V}\",PROCESSOS!$Y$2:$Y$1500)" },
          { "h": "Resultado",      "fmt": "moeda", "f": "=SUMIF(PROCESSOS!$H$2:$H$1500,\"{V}\",PROCESSOS!$AA$2:$AA$1500)" }
        ] }
    ]
  }
}
