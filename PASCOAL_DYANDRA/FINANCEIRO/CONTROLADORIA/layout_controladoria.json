    {
      "nome": "EXITO",
      "linhas": 1500,
      "congelar_linha": 1,
      "congelar_coluna": 2,
      "colunas": [
        { "h": "Nº Pasta",                    "w": 11, "fmt": "texto" },
        { "h": "Cliente",                     "w": 34, "fmt": "geral", "calc": true,
          "f": "=IF($A2=\"\",\"\",IFERROR(VLOOKUP($A2,PROCESSOS!$A$2:$B$1500,2,FALSE),\">>> PASTA NÃO CADASTRADA\"))" },
        { "h": "Data do Êxito",               "w": 14, "fmt": "data" },
