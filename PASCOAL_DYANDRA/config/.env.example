# -----------------------------------------------------------------------------
#  CREDENCIAIS / TOKENS  (preencher no onboarding)
#  ATENCAO (briefing 14/08/2026): o escritorio NAO usa ADVBOX/ZapSign/Atende
#  Direito - usa Astrea (gestao), Autentique (assinatura) e Leadone/GoHighLevel
#  (CRM/atendimento, via agencia de mkg).
#    - CRM/atendimento: JA INTEGRADO em INTEGRACOES/leadone_integration.py.
#      Preencher LEADONE_TOKEN e LEADONE_LOCATION_ID mais abaixo. Enquanto
#      estiverem vazios, os envios sao pulados sem quebrar o fluxo.
#    - Gestao (Astrea) e assinatura (Autentique): ainda PENDENTES - falta
#      escrever INTEGRACOES/astrea_integration.py e autentique_integration.py.
#      Ate la ADVBOX_API_TOKEN e ZAPSIGN_API_TOKEN ficam vazios de proposito.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ADVBOX_API_TOKEN=
ASAAS_API_TOKEN=
ASAAS_BASE_URL=https://api.asaas.com/v3
ZAPSIGN_API_TOKEN=
ATENDE_DIREITO_TOKEN=

# -----------------------------------------------------------------------------
#  CRM / SOFTWARE DE ATENDIMENTO
#  Qual CRM as automacoes usam para falar com o cliente (WhatsApp):
#    leadone       -> Leadone / GoHighLevel  (o que o escritorio usa)
#    atendedireito -> Atende Direito         (heranca do molde de origem)
#  Todos os chamadores passam por INTEGRACOES/crm.py, entao trocar aqui basta.
# -----------------------------------------------------------------------------
CRM_PROVIDER=leadone

# Private Integration Token da SUBCONTA do escritorio no Leadone. Quem gera e a
# agencia de marketing (dona da subconta): Settings > Private Integrations.
# Escopos necessarios: contacts.readonly, contacts.write, conversations.readonly,
# conversations.write, conversations/message.readonly, conversations/message.write,
# workflows.readonly. Ver docs/INTEGRACAO_LEADONE.md.
LEADONE_TOKEN=
# ID da subconta (Location ID) - Settings > Business Profile, ou na URL do painel:
LEADONE_LOCATION_ID=
# Canal de envio. Use WhatsApp se a subconta tem provedor de WhatsApp conectado;
# se so houver SMS habilitado, troque para SMS:
LEADONE_CANAL=WhatsApp
# DDI usado ao converter telefone brasileiro para E.164 (+55...):
LEADONE_DDI=55
# Segredo compartilhado dos webhooks disparados por "Custom Webhook" de workflow
# (o GHL nao assina esses). Gere um valor aleatorio e peca a agencia para incluir
# como header `x-leadone-secret` no workflow. Webhooks NATIVOS nao usam isto -
# sao validados pela assinatura RSA `x-wh-signature`:
LEADONE_WEBHOOK_SECRET=
# Sobrescreve a chave publica de validacao, caso a HighLevel rotacione a dela
# (PEM em uma linha, com \n literais). Vazio = usa a chave embutida no codigo:
LEADONE_WEBHOOK_PUBKEY=
# Base da API (so mude se a HighLevel mudar o dominio):
# LEADONE_BASE_URL=https://services.leadconnectorhq.com
# Caminho do JSON de credenciais do Google Cloud (service account ou OAuth):
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json
GOOGLE_OAUTH_CREDENTIALS=config/oauth_credentials.json
# Conta Google do escritorio dona do Drive. O setup avisa se logar em outra:
GOOGLE_CONTA_ESPERADA=advocaciapascoal@gmail.com
# Caminho do executavel do Tesseract (OCR), se nao estiver no PATH:
TESSERACT_CMD=
# Modelo LLM usado na geracao de pecas (opcional; ha default no codigo):
LLM_MODEL_PECA=

